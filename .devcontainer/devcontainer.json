{
  "name": "Node.js & TypeScript",
  "image": "mcr.microsoft.com/devcontainers/typescript-node",

  "mounts": [
    "source=${localEnv:HOME}/.pi,target=/home/node/.pi,type=bind",
    "source=${localEnv:HOME}/.agents,target=/home/node/.agents,type=bind"
  ],

  "postCreateCommand": "yarn install && npm install -g @earendil-works/pi-coding-agent && npm install -g agent-browser",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "bradlc.vscode-tailwindcss"]
    }
  }
}
